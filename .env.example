# Copy to .env (chmod 600). Supply independently generated secrets; never commit .env.
MYSQL_DATABASE=compte
MYSQL_USERNAME=compte
MYSQL_PASSWORD=
DB_MIGRATION_USERNAME=compte_migration
DB_MIGRATION_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_PORT=8080
APP_URL=http://localhost:8080
# Initial setup only; disable after installation.
APP_SETUP_ENABLED=false
APP_SETUP_TOKEN=
APP_TRUSTED_PROXIES=
APP_SESSION_SECURE=false
APP_HSTS_MAX_AGE=
